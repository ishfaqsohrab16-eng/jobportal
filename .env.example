# ---------------------------------------------------------------------------
# DigiBizz Jobs - environment
#
# Local development: copy to apps/api/.env (values below work as-is).
# Easypanel (one service = API + web): set these in the service's Environment
# tab, using the "production" values shown in the comments.
# ---------------------------------------------------------------------------

# development | production   (production on Easypanel)
NODE_ENV=development

# Easypanel: 3000 (the Dockerfile default) - set the domain's proxy port to 3000.
PORT=4000

# Local: a mongodb:// URI, or "memory" for an embedded dev database.
# Easypanel: the MongoDB service's *internal* URL + database name, e.g.
#   mongodb://mongo:<password>@<project>_mongo:27017/digibizz_jobs?authSource=admin
MONGODB_URI=mongodb://localhost:27017/digibizz_jobs

# Long random string (32+ chars) - required in production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# The public address of the portal. Partner (IndusTech) apply links are built from it.
# Easypanel: your domain, e.g. https://jobs.digibizz.pk
PUBLIC_WEB_URL=http://localhost:5173

# Only needed when the web app runs on a different origin (local Vite dev server).
CORS_ORIGINS=http://localhost:5173

# First admin account, created on startup if no admin exists yet.
ADMIN_NAME=DigiBizz Admin
ADMIN_EMAIL=admin@digibizz.pk
ADMIN_PASSWORD=ChangeThisStrongPassword!

# Number of reverse proxies in front of the app (Easypanel/Traefik = 1).
TRUST_PROXY=1

# Set by the Dockerfile - only override if you change the image layout:
#   WEB_DIST_DIR=/app/web        built web app served by the API
#   UPLOAD_DIR=/data/uploads     resumes; mount a persistent volume at /data
